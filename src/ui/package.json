{
  "name": "ui",
  "description": "htmx-tailwind-ui",
  "main": "postcss.config.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "esbuild": "node ./build.mjs",
    "build": "npm run type-check && npm run esbuild && postcss ./input.css -o ./public/static/output.css"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.4",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.1",
    "daisyui": "^5.0.0-beta.6",
    "esbuild": "0.24.2",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^4.0.4",
    "typescript": "^5.7.3"
  }
}
