<form hx-post="/components/submit" hx-ext="json-enc" hx-target="this" hx-swap="outerHTML">
  <div class="flex flex-col space-y-4 p-4 max-w-md mx-auto">
    <input type="text" name="word1" placeholder="First word" maxlength="20"
      class="input input-bordered w-full max-w-xs mx-auto" oninput="validateInput(this)"
      value="{{ word1 if word1 is defined else '' }}">
    <input type="text" name="word2" placeholder="Second word" maxlength="20"
      class="input input-bordered w-full max-w-xs mx-auto" oninput="validateInput(this)"
      value="{{ word2 if word2 is defined else '' }}">
    <button type="submit" id="submitBtn" class="btn btn-primary max-w-xs mx-auto" disabled>
      Submit Words
    </button>
    {% if score is defined %}
    <div class="max-w-xs mx-auto text-center">
      word1: {{ word1 }}<br>
      word2: {{ word2 }}<br>
      Score: {{ score }}
    </div>
    {% endif %}
    <div id="highScoreDisplay" class="max-w-xs mx-auto text-center mt-4">
      <div class="flex items-center justify-center">
        <h3 class="font-bold text-center">High Score</h3>
      </div>
      <p id="highScoreText" class="text-sm"></p>
      <p id="highScoreWords" class="text-sm"></p>
      <button id="copyHighScoreBtn" type="button" onclick="copyHighScore()" class="btn btn-s mt-2" title="Share score">
        <span id="copyText">Copy High Score !</span>
        <svg id="copyIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
          stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
      </button>
    </div>
  </div>
</form>
<script>
  // Initialize high score tracking
  function getHighScore() {
    const storedScore = localStorage.getItem('highScore');
    if (storedScore) {
      return JSON.parse(storedScore);
    }
    return null
  }

  function updateHighScore(newScore, word1, word2) {
    const currentHigh = getHighScore();
    let newHighScore = { score: newScore, word1: word1, word2: word2 };

    if (currentHigh && currentHigh.score > newScore) {
      newHighScore = { score: currentHigh.score, word1: currentHigh.word1, word2: currentHigh.word2 };
    }

    localStorage.setItem('highScore', JSON.stringify(newHighScore));
    displayHighScore();
  }

  function displayHighScore() {
    const highScore = getHighScore();
    const highScoreText = document.getElementById('highScoreText');
    const highScoreWords = document.getElementById('highScoreWords');
    const highScoreDisplay = document.getElementById('highScoreDisplay');
    if (highScore) {
      if (highScoreText && highScoreWords) {
        highScoreText.textContent = `High Score: ${highScore.score}`;
        highScoreWords.textContent = `Words: ${highScore.word1}, ${highScore.word2}`;
        highScoreDisplay.style.display = 'block';
      }
    } else {
      highScoreDisplay.style.display = 'none';
    }
  }

  function validateInput(input) {
    const value = input.value;
    const isValid = /^[A-Za-z]*$/.test(value);
    if (!isValid || value.length > 20) {
      input.style.borderColor = 'red';
      input.style.color = 'red';
    } else {
      input.style.borderColor = '';
      input.style.color = '';
    }
    const word1 = document.querySelector('input[name="word1"]').value;
    const word2 = document.querySelector('input[name="word2"]').value;
    const isWord1Valid = /^[A-Za-z]*$/.test(word1);
    const isWord2Valid = /^[A-Za-z]*$/.test(word2);
    document.getElementById('submitBtn').disabled = !(word1 && word2 && isWord1Valid && isWord2Valid);
  }

  // Check and update high score when new score is displayed
  {% if score is defined %}
  updateHighScore({{ score }}, "{{ word1 }}", "{{ word2 }}");
  {% endif %}

  // Display high score on page load
  displayHighScore();

  function copyHighScore() {
    const highScore = getHighScore();
    if (highScore) {
      const shareText = `🎯Checkout Out My High Score: ${highScore.score}\n📝 Words: ${highScore.word1} | ${highScore.word2}\n\nPlay at: https://mismatch.raphaelvanhoffelen.com`;
      navigator.clipboard.writeText(shareText);

      const copyIcon = document.getElementById('copyIcon');
      const copyText = document.getElementById('copyText');

      copyIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />`;
      copyText.textContent = 'Copied!';

      // Revert back after 2 seconds
      setTimeout(() => {
        copyText.textContent = 'Copy High Score!';
        copyIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />      `;
      }, 2000);
    }
  }

</script>